}

\ifucasfullcover
    \title{\vspace{3cm} \heiti \Huge \textbf{\UCASReportTitle} \par \vspace{1.5cm}}
    \author{\UCASFullCoverAuthor}
\else
    \title{\vspace{3cm} \heiti \Huge \textbf{\UCASCoverTitle} \par
    \vspace{1cm}
    \heiti \Large {\underline{\UCASReportTitle}}
    \vspace{3cm}}
    \author{\UCASReducedCoverAuthor}
\fi

